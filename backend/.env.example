# PostgreSQL ulanish satri
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qoraqalpogiston
# JWT — ishlab chiqarishda albatta almashtiring
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Claude API kaliti. Bo'sh qoldirilsa AI endpointlari mahalliy (offline)
# RAG dvigateliga tushadi — platforma baribir to'liq ishlaydi.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Frontend manzillari (vergul bilan ajratiladi)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100

# admin/rahbar esapları ushın parol — jańa bazada bir mártege
# jaratıladı. Bo'sh qoldirilsa kездейсоқ parol jaratılıp, server
# logına jazıladı (deployер ony sonnan alıp, admin panelinde
# ózgertiwi kerek).
ADMIN_PASSWORD=
RAHBAR_PASSWORD=
